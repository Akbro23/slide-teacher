# Google Gemini API key. Server-side only, never exposed to the browser.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Overrides the model both routes use.
# Defaults to gemini-3.5-flash-lite. Run
#   node --env-file=.env.local scripts/list-models.mjs
# to see what your key can access.
# AI_MODEL=gemini-flash-lite-latest
